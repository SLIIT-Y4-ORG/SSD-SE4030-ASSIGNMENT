# ─── Service URLs ────────────────────────────────────────────────────────────
PATIENT_SERVICE_URL=http://localhost:8082
DOCTOR_SERVICE_URL=http://localhost:8083
USER_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8080

# ─── Internal API Keys ───────────────────────────────────────────────────────
# Internal API key shared with the payment service.
# Must match PAYMENT_INTERNAL_API_KEY in paymentService/.env
# Generate using a secure random generator (e.g. openssl rand -base64 32)
PAYMENT_INTERNAL_API_KEY=replace-with-a-strong-random-secret
