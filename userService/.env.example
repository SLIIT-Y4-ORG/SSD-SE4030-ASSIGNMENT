DB_URL=jdbc:postgresql://database-host:5432/database?sslmode=require
DB_USERNAME=database-user
DB_PASSWORD=replace-with-database-password

# Generate a random secret with at least 32 characters. Never commit the value.
SECURITY_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional one-time administrator bootstrap. Leave all three empty after the
# account has been created, or keep them in a managed secret store.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Google OAuth 2.0 / OpenID Connect credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback


