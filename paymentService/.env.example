# ─── Database Configuration ──────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/paymentdb
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ─── Stripe Configuration ────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# ─── Internal API Keys ───────────────────────────────────────────────────────
# Internal API key checked against requests from the appointment service.
# Must match PAYMENT_INTERNAL_API_KEY in appointmentService/.env
# Generate using a secure random generator (e.g. openssl rand -base64 32)
PAYMENT_INTERNAL_API_KEY=replace-with-a-strong-random-secret
PAYMENT_INTERNAL_AUTH_ENABLED=true